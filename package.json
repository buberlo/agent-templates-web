{
  "name": "agent-templates-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fetch-content": "node scripts/fetch-content.mjs",
    "prebuild": "npm run fetch-content",
    "predev": "npm run fetch-content",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/content/*.test.ts lib/export/*.test.ts",
    "cli:build": "tsc -p packages/cli/tsconfig.json && esbuild packages/cli/src/index.ts --tsconfig=packages/cli/tsconfig.json --bundle --platform=node --target=node20 --external:gray-matter --banner:js='#!/usr/bin/env node' --outfile=packages/cli/dist/index.js && node -e \"require('node:fs').chmodSync('packages/cli/dist/index.js', 0o755)\"",
    "cli:test": "tsx --test packages/cli/test/*.test.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "flexsearch": "^0.7.43",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
